# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# Optional — random secret to gate the escalations cron endpoint
# CRON_SECRET=

# Optional — free Groq API key powers the AI goal assistant + check-in summaries.
# Get one at https://console.groq.com/keys (free tier). Leave unset to disable AI.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
