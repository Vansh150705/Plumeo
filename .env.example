# ---------- Required ----------
# Restricted application login (subject to row-level security). See deploy/init-db.sh / README for creating it.
DATABASE_URL=postgres://plumeo_app:change-me@localhost:5432/plumeo
# Owner role used ONLY by `npm run migrate` (creates tables, policies, triggers).
MIGRATION_DATABASE_URL=postgres://plumeo:change-me@localhost:5432/plumeo
# Public URL of the app (used in emails, SSO redirect URIs and secure-cookie detection).
APP_URL=http://localhost:3000
# 32 random bytes — encrypts SSO client secrets and webhook URLs at rest. Generate: openssl rand -base64 32
# REQUIRED in production; the server refuses to start without it. Losing it makes stored secrets unreadable.
APP_ENCRYPTION_KEY=

# ---------- Docker Compose only ----------
# POSTGRES_PASSWORD=
# APP_DB_PASSWORD=

# ---------- Optional ----------
# Shared secret for POST/GET /api/v1/jobs/run when you drive background work from an external scheduler (min 16 chars).
# CRON_SECRET=
# Email: any nodemailer SMTP URL, e.g. smtps://user:pass@smtp.example.com:465 . Unset = in-app notifications only.
# SMTP_URL=
# SMTP_FROM="Plumeo <no-reply@example.com>"
# Self-service organisation sign-up (/signup). Default: enabled outside production, disabled in production.
# ALLOW_SELF_SERVICE_SIGNUP=false
# AI writing assistance (Groq, free tier). Also needs to be enabled per organisation in Policies.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# DB_POOL_MAX=10
# LOG_LEVEL=info
# Background worker cadence
# WORKER_DELIVERY_SECONDS=20
# WORKER_SWEEP_MINUTES=60
