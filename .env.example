# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# Optional — random secret to gate the cron endpoints
# CRON_SECRET=

# AI goal-drafting assistant (Vercel AI Gateway). When unset, the assistant
# is hidden and the app works exactly as before. On Vercel, OIDC can stand in
# for the key automatically.
# AI_GATEWAY_API_KEY=
# AI_GOAL_MODEL=anthropic/claude-sonnet-4-6

# Notification delivery. When unset, Email/Teams notifications stay queued
# (shown as un-sent) instead of being faked as delivered.
# TEAMS_WEBHOOK_URL=        # MS Teams incoming-webhook URL
# EMAIL_WEBHOOK_URL=        # JSON relay that sends mail ({ to, subject, text, link })
# NEXT_PUBLIC_APP_URL=      # used to build absolute deep links in delivered messages
