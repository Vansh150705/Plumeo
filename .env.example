# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# Required for the nightly escalation sweep. The cron endpoint refuses to run without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in Vercel; Vercel Cron then sends it automatically.
CRON_SECRET=replace-with-a-long-random-string

# Optional — free Groq API key powers the AI goal assistant + check-in summaries.
# Get one at https://console.groq.com/keys (free tier). Leave unset to disable AI.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
